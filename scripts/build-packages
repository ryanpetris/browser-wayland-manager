#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
mkdir -p dist
for distribution in "${@:-arch debian}"; do
    for target in $distribution; do
        case "$target" in arch|debian) ;; *) echo 'Expected arch or debian' >&2; exit 1;; esac
        image="browser-wayland-manager-package:$target"
        docker build --build-arg "BWM_VERSION=${BWM_VERSION:-}" -f packaging/Dockerfile --target "$target" -t "$image" .
        container=$(docker create "$image")
        trap 'docker rm "$container" >/dev/null' EXIT HUP INT TERM
        docker cp "$container:/packages/." dist/
        docker rm "$container" >/dev/null
        trap - EXIT HUP INT TERM
    done
done
