pkgname=elsewhere-innkeeper
pkgver=0.1.0
pkgrel=1
pkgdesc='Manage isolated Elsewhere Docker desktops'
arch=('x86_64')
license=('MIT')
# Native crypto assembly is incompatible with makepkg's injected C LTO flags.
options=('!lto')
backup=('etc/elsewhere-innkeeper/environment')
depends=('docker' 'curl' 'ca-certificates' 'gcc-libs')
makedepends=('rust' 'nodejs' 'npm' 'git')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    (cd web && npm ci --no-audit --no-fund && npm run build)
    cargo build --release --locked
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --locked
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 target/release/elsewhere-innkeeper "$pkgdir/usr/bin/elsewhere-innkeeper"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 packaging/elsewhere-innkeeper.service "$pkgdir/usr/lib/systemd/system/elsewhere-innkeeper.service"
    install -Dm644 packaging/elsewhere-innkeeper.sysusers "$pkgdir/usr/lib/sysusers.d/elsewhere-innkeeper.conf"
    install -Dm644 packaging/environment "$pkgdir/etc/elsewhere-innkeeper/environment"
    install -d "$pkgdir/usr/share/$pkgname"
    cp -r sessions "$pkgdir/usr/share/$pkgname/"
}
