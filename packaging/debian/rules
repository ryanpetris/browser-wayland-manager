#!/usr/bin/make -f
%:
	dh $@
override_dh_auto_build:
	cd web && npm ci --no-audit --no-fund && npm run build
	cargo build --release --locked
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test --locked
endif
override_dh_auto_install:
	install -Dm755 target/release/elsewhere-innkeeper debian/elsewhere-innkeeper/usr/bin/elsewhere-innkeeper
	install -Dm644 packaging/environment debian/elsewhere-innkeeper/etc/elsewhere-innkeeper/environment
	install -Dm644 packaging/elsewhere-innkeeper.service debian/elsewhere-innkeeper/usr/lib/systemd/system/elsewhere-innkeeper.service
	install -Dm644 packaging/elsewhere-innkeeper.sysusers debian/elsewhere-innkeeper/usr/lib/sysusers.d/elsewhere-innkeeper.conf
	install -d debian/elsewhere-innkeeper/usr/share/elsewhere-innkeeper
	cp -r sessions debian/elsewhere-innkeeper/usr/share/elsewhere-innkeeper/
override_dh_auto_clean:
	rm -rf target web/dist web/node_modules
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
